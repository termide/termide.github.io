---
/** The blog's feed: every post, or one kind of them (releases, guides). */
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Tags from '../components/Tags.astro';
import { localePath, t, type Locale } from '../lib/i18n';
import { getPosts, getUsedTags, kinds, kindSegment, type Kind } from '../lib/content';
import '../styles/blog.css';

interface Props { locale: Locale; kind?: Kind }
const { locale, kind } = Astro.props;
const posts = await getPosts(locale, kind);
const tags = await getUsedTags();
const path = kind ? `/blog/${kindSegment[kind]}/` : '/blog/';
const title = kind ? t(locale, `blog.kinds.${kind}`) : t(locale, 'blog.title');
---

<Base locale={locale} path={path} title={`${title} — TermIDE`} description={t(locale, 'blog.subtitle')} current="blog">
  <section class="blog">
    <h1 class="section-title">{title}</h1>
    <p class="section-subtitle">{t(locale, 'blog.subtitle')}</p>
    <nav class="blog-filters">
      <a href={localePath(locale, '/blog/')} class:list={['filter-btn', { active: !kind }]}>{t(locale, 'blog.all')}</a>
      {kinds.map((k) => (
        <a href={localePath(locale, `/blog/${kindSegment[k]}/`)} class:list={['filter-btn', { active: k === kind }]}>{t(locale, `blog.kinds.${k}`)}</a>
      ))}
      <a href={localePath(locale, '/rss.xml').replace(/\/$/, '')} class="filter-btn blog-rss">{t(locale, 'blog.rss')}</a>
    </nav>
    <Tags locale={locale} tags={tags} />
    <PostList locale={locale} posts={posts} />
  </section>
</Base>
