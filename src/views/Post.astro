---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tags from '../components/Tags.astro';
import data from '../data.json';
import { absoluteUrl, formatDate, localePath, t, type Locale } from '../lib/i18n';
import { slugOf, type Post } from '../lib/content';
import '../styles/blog.css';

interface Props { locale: Locale; post: Post }
const { locale, post } = Astro.props;
const { Content } = await render(post);
const slug = slugOf(post);
const { title, subtitle, description, date, updated, kind, version, tags, cover, coverAlt, coverInPost, discussion } = post.data;
const ogImage = cover && absoluteUrl((await getImage({ src: cover, width: 1200, format: 'jpg' })).src);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  inLanguage: locale,
  url: absoluteUrl(localePath(locale, `/blog/${slug}/`)),
  ...(ogImage && { image: ogImage }),
  publisher: { '@type': 'Organization', name: 'Termide', url: data.site_url },
};
---

<Base locale={locale} path={`/blog/${slug}/`} title={`${title} — Termide`} description={description} ogImage={ogImage} ogType="article" current="blog">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/<\//g, '<\\/')} />
  <article class="post">
    <header class="post-header">
      <p class="post-meta">
        <a href={localePath(locale, `/blog/${kind === 'release' ? 'releases' : 'guides'}/`)} class:list={['post-kind', `post-kind-${kind}`]}>{t(locale, `blog.kind.${kind}`)}{version && ` ${version}`}</a>
        <time datetime={date.toISOString()}>{formatDate(locale, date)}</time>
      </p>
      <h1>{title}</h1>
      {subtitle && <p class="post-subtitle">{subtitle}</p>}
      <Tags locale={locale} tags={tags} />
    </header>
    {cover && coverInPost && (
      <figure class="post-cover terminal-frame neon-border" data-lightbox>
        <Image src={cover} alt={coverAlt ?? ''} widths={[800, 1600]} sizes="(max-width: 860px) 100vw, 800px" loading="eager" />
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
    <footer class="post-footer">
      {kind === 'release' && version && (
        <a class="btn btn-secondary" href={`${data.repo_url}/releases/tag/${version}`} target="_blank" rel="noopener"><span class="btn-icon">&gt;</span> {t(locale, 'blog.notes')}</a>
      )}
      <a class="btn btn-secondary" href={`${localePath(locale, '/')}#install`}><span class="btn-icon">$</span> {t(locale, 'blog.install')}</a>
      {discussion && <a class="btn btn-secondary" href={discussion} target="_blank" rel="noopener"><span class="btn-icon">#</span> {t(locale, 'blog.discuss')}</a>}
      <a class="post-back" href={localePath(locale, '/blog/')}>&lt; {t(locale, 'blog.back')}</a>
    </footer>
  </article>
</Base>
