  "install": [
    {
      "id": "script",
      "command": "curl -fsSL https://raw.githubusercontent.com/termide/termide/main/install.sh | sh"
    },
    {
      "id": "static",
      "command": "curl -LO https://github.com/termide/termide/releases/latest/download/termide-{v}-x86_64-unknown-linux-musl.tar.gz\ntar xzf termide-{v}-x86_64-unknown-linux-musl.tar.gz && ./termide"
    },
    {
      "id": "brew",
      "command": "brew tap termide/termide\nbrew install termide"
    },
    {
      "id": "arch",
      "command": "yay -S termide-bin"
    },
    {
      "id": "nix",
      "command": "nix run github:termide/termide"
    },
    {
      "id": "deb",
      "command": "curl -LO https://github.com/termide/termide/releases/latest/download/termide_{v}-1_amd64.deb\nsudo dpkg -i termide_{v}-1_amd64.deb"
    },
    {
      "id": "rpm",
      "command": "sudo rpm -i https://github.com/termide/termide/releases/latest/download/termide-{v}-1.x86_64.rpm"
    },
    {
      "id": "termux",
      "command": "pkg install git openssh\ncurl -LO https://github.com/termide/termide/releases/latest/download/termide-{v}-aarch64-unknown-linux-musl.tar.gz\ntar xzf termide-{v}-aarch64-unknown-linux-musl.tar.gz && ./termide"
    },
    {
      "id": "windows",
      "command": "https://github.com/termide/termide/releases/latest/download/termide-{v}-x86_64-pc-windows-msvc.zip"
    }
  ],
