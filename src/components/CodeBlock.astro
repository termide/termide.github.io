---
/**
 * A copyable command. `{v}` in it stands for the release version the site was built with; a
 * release sets it in data.json and the push rebuilds the site.
 */
import data from '../data.json';
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale; command: string; class?: string }
const { locale, command, class: extra } = Astro.props;
const shown = command.replaceAll('{v}', data.version);
---

<div class:list={['code-block', extra]}>
  <pre><code>{shown}</code></pre>
  <button class="copy-btn" data-copy={shown} title={t(locale, 'install.copy')}><span class="copy-icon">&#128203;</span></button>
</div>
