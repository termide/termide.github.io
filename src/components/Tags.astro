---
import { localePath, t, type Locale } from '../lib/i18n';

interface Props { locale: Locale; tags: string[]; current?: string }
const { locale, tags, current } = Astro.props;
---

{tags.length > 0 && (
  <ul class="post-tags">
    {tags.map((tag) => (
      <li><a href={localePath(locale, `/blog/tags/${tag}/`)} class:list={{ active: tag === current }}>#{t(locale, `blog.tags.${tag}`)}</a></li>
    ))}
  </ul>
)}
