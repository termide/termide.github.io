---
/**
 * A short screen recording in the terminal frame: plays muted on a loop, like a GIF at a
 * fraction of the size. Under prefers-reduced-motion it waits on its poster until played.
 * `src` and `poster` are URLs under /assets/blog/<slug>/ (videos are not processed by Astro).
 */
interface Props { src: string; poster?: string; caption?: string; title?: string; label: string }
const { src, poster, caption, title = 'termide', label } = Astro.props;
---

<figure class="shot">
  <div class="terminal-frame neon-border">
    <div class="terminal-header">
      <span class="terminal-dot red"></span>
      <span class="terminal-dot yellow"></span>
      <span class="terminal-dot green"></span>
      <span class="terminal-title">{title}</span>
    </div>
    <video src={src} poster={poster} aria-label={label} muted loop playsinline controls preload="metadata" data-autoplay></video>
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still) {
    // Play only while in view: a long post with several recordings stays light.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }
    }, { threshold: 0.4 });
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => io.observe(v));
  }
</script>
